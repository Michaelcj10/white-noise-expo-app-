{
  "expo": {
    "name": "Slumbr",
    "slug": "WhiteNoiseApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "slumbr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.slumbr.whitenoiseapp"
    },
    "android": {
      "package": "com.slumbr.whitenoiseapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-android.png",
        "backgroundColor": "#0A0903"
      },
      "edgeToEdgeEnabled": true,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.slumbr.whitenoiseapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0A0903",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#0A0903"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7c23296f-b4e9-4dd4-ab36-53b654b8a2df"
      }
    },
    "owner": "admin-taggd-01"
  }
}
